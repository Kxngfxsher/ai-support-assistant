# Скопируйте этот файл в .env и заполните нужное. Без .env демо работает на правилах.

# Движок ответов: auto (Claude, если задан ключ; иначе правила) | rules | claude
ENGINE=auto

# Ключ Anthropic API: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Сколько минут оператор тратит на один типовой вопрос (для оценки экономии)
MANUAL_MINUTES_PER_QUESTION=3

# Токен Telegram-бота от @BotFather: нужен только для python telegram_bot.py
TELEGRAM_BOT_TOKEN=
